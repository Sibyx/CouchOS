            <control type="label">
                <left>330</left><top>0</top><width>126</width><height>84</height>
                <align>right</align><aligny>center</aligny><font>font12</font><textcolor>FFFFD23F</textcolor>
                <label>$INFO[Window.Property(kind)]</label>
            </control>
        </control>

        <control type="panel" id="200">
            <left>72</left><top>200</top><width>480</width><height>432</height>
            <onup>200</onup>
            <ondown>201</ondown>
            <onright>301</onright>
            <onleft>200</onleft>
            <orientation>vertical</orientation>
            <scrolltime>0</scrolltime>
            <itemlayout width="80" height="72">
                <control type="label">
                    <left>0</left><top>0</top><width>80</width><height>72</height>
                    <align>center</align><aligny>center</aligny><font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[ListItem.Property(label)]</label>
                </control>
            </itemlayout>
            <focusedlayout width="80" height="72">
                <control type="image">
                    <left>4</left><top>4</top><width>72</width><height>64</height>
                    <texture border="24" colordiffuse="FFFFD23F">card.png</texture>
