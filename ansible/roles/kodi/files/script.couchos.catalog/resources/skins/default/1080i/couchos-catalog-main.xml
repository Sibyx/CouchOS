            <left>1648</left><top>184</top><width>200</width><height>28</height>
            <align>right</align><font>font10</font><textcolor>FF5A5A5A</textcolor>
            <label>more above</label>
            <visible>!String.IsEmpty(Window.Property(above))</visible>
