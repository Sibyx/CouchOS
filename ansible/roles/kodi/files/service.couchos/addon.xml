<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.couchos" name="CouchOS" version="1.1.0" provider-name="CouchOS">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <!-- Plex starts through PM4K's own kiosk mode; this add-on only runs CEC for couchd. -->
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">CouchOS integration</summary>
        <description lang="en_GB">Runs HDMI-CEC commands for couchd.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
