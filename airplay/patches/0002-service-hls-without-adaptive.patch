+    have_adaptive = xbmc.getCondVisibility('System.AddonIsEnabled(inputstream.adaptive)')
+    if not have_adaptive:
+        log('inputstream.adaptive is not installed, leaving the playlist to ffmpeg')
+    if have_adaptive and (path.endswith('.m3u8') or path.endswith('.mpd')):
         # Left to ffmpeg's HLS demuxer this fails at the first segment: the
