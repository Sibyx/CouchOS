# Build output (images from image/build.sh, UxPlay bundle from uxplay/build.sh,
# the Kodi AirPlay add-on from airplay/build.sh, dashd from dashd/build.sh)
/out/
/uxplay/dist/
/airplay/dist/
/dashd/dist/
/dashd/target/

# pi-gen lives in ~/.cache/couchos; never vendor it here
/pi-gen/

# Local tooling
.venv/
__pycache__/
*.py[cod]
.mcp.json
.claude/settings.local.json

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
/repos/couchos-app/build/

# Ansible
*.retry
ansible/.vault-pass
ansible/group_vars/couchos/local.yml

# Leftover from another project (nothing builds from the repo root)
/.dockerignore

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
