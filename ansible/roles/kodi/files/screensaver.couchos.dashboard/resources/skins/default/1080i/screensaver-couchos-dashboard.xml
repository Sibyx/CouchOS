<?xml version="1.0" encoding="UTF-8"?>
<!-- CouchOS dashboard, 1920x1080, on black. A fixed grid, so nothing can
     overlap: three columns over a bottom row of cards.

       x   72 ......... 672  704 ...... 1216  1248 ....... 1848
     y  36 time, date        the duck         the frog of the day
       262 today's weather   (512 x 512)      (photo 600 x 300,
           next hours        its line         names, summary)
       712 the bottom row: three cards of 570, flexible (see there)
      1016
      1032 "data is not updating" (only when stale)

     Margins: 72 left and right, 32 between columns; the burn-in drift
     (dashboard.py SHIFTS, up to 8 x 10 px) stays inside the screen.
     The duck and the frog (with its photo) are always there. The bottom row
     shows only cards with something in them: a message from the app
     (first, yellow, two slots wide: the next days step aside for it), TO DO
     when it has items, what is playing when something plays audio only (AirPlay from
     Spotify, Plex music), and next days and the app. What doesn't fit
     shares the last slot as a carousel, a slide every 20 s
     (Window.Property(slide), set by dashboard.py; a slide without data is
     skipped). With nothing on the board, next days goes wide (five days).

     Fonts are Estuary's (Kodi's default skin), used at their native size:
     scaling a font with a zoom animation scales its glyph texture, which
     blurs it and redraws the label every frame. No scrolling labels either
     (they redraw all the time): long text is cut.
       WeatherTemp  Noto Sans bold 120     font37 / font27  Noto Sans 37 / 27
       font12 / font10  Noto Sans 25 / 23
     Data: Window.Property(<widget id>.<key>) from dashd's /v1/views/tv.
     Now playing comes from Kodi itself: Player.*, MusicPlayer.* (Plex music)
     and Window(Home).Property(AirPlay.*) (inputstream.airplay, CouchOS patch
     0003: its player item has no info tag, so the artist is only there).
     Images dashd draws (duck, QR) are exactly the size placed here, within
     Kodi's 540 px image texture limit, so they are never scaled.
     Textures: white.png, card.png (rounded, 9-sliced with border 24),
     dot.png; all white, tinted with colordiffuse.
     Weather icons: Kodi's stock set, resource.images.weathericons.default.

     Careful with $INFO[info,prefix,suffix]: commas separate its parts, so
     no comma may appear inside one (System.Date(DDDD, D MMMM) breaks).

     Colours: FFF2F2F2 primary, FFB8B8B8 secondary, FF8A8A8A labels,
     FF5A5A5A quiet, FFFFD23F accent (the duck's yellow), FF7FB2E5
     precipitation, card background 14FFFFFF. -->
<window>
    <defaultcontrol>-</defaultcontrol>
    <animation effect="fade" time="500">WindowOpen</animation>
    <animation effect="fade" time="250">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
        </control>

        <!-- Everything moves together a few pixels every few minutes (burn-in). -->
        <control type="group" id="100">
            <left>0</left><top>0</top>

            <!-- ================= left: time, date, today ================= -->
            <control type="label">
                <left>68</left><top>28</top><width>604</width><height>150</height>
                <font>WeatherTemp</font><textcolor>FFF2F2F2</textcolor>
                <label>$INFO[System.Time(HH:mm)]</label>
            </control>
            <control type="label">
                <left>74</left><top>172</top><width>598</width><height>50</height>
                <font>font37</font><textcolor>FFB8B8B8</textcolor>
                <label>$INFO[System.Date(DDDD)] $INFO[System.Date(D MMMM)]</label>
            </control>

            <control type="group">
                <left>72</left><top>262</top>
                <visible>!String.IsEmpty(Window.Property(weather.temp))</visible>
                <control type="image">
                    <left>-8</left><top>0</top><width>120</width><height>120</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(weather.icon),resource://resource.images.weathericons.default/,.png]</texture>
                </control>
                <control type="label">
                    <left>124</left><top>0</top><width>230</width><height>120</height>
                    <aligny>center</aligny>
                    <font>WeatherTemp</font><textcolor>FFF2F2F2</textcolor>
                    <label>$INFO[Window.Property(weather.temp)]</label>
                </control>
                <!-- font27 bold: "Thunderstorm, hail" fits 244 px -->
                <control type="label">
                    <left>356</left><top>20</top><width>244</width><height>44</height>
                    <font>font27</font><textcolor>FFF2F2F2</textcolor>
                    <label>[B]$INFO[Window.Property(weather.condition)][/B]</label>
                </control>
                <control type="label">
                    <left>356</left><top>64</top><width>244</width><height>40</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(weather.feels)]</label>
                </control>
                <control type="label">
                    <left>0</left><top>134</top><width>600</width><height>40</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(weather.highlow)]$INFO[Window.Property(weather.rain),   ·   ]$INFO[Window.Property(weather.sun),   ·   Sun ]</label>
                </control>

                <!-- next hours: 4 x 150. Columns written out: a script window
                     cannot use skin includes. Only the index and left differ. -->
                <control type="label">
                    <left>0</left><top>204</top><width>600</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>NEXT HOURS</label>
                </control>
                <control type="group"><left>0</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>150</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour1.time)]</label></control>
                    <control type="image"><left>43</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour1.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>150</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour1.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>150</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour1.rain)]</label></control>
                </control>
                <control type="group"><left>150</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>150</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour2.time)]</label></control>
                    <control type="image"><left>43</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour2.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>150</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour2.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>150</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour2.rain)]</label></control>
                </control>
                <control type="group"><left>300</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>150</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour3.time)]</label></control>
                    <control type="image"><left>43</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour3.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>150</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour3.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>150</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour3.rain)]</label></control>
                </control>
                <control type="group"><left>450</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>150</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour4.time)]</label></control>
                    <control type="image"><left>43</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour4.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>150</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour4.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>150</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour4.rain)]</label></control>
                </control>
            </control>

            <!-- ================= centre: the duck ================= -->
            <control type="image">
                <left>704</left><top>40</top><width>512</width><height>512</height>
                <fadetime>400</fadetime>
                <texture background="true">$INFO[Window.Property(weather.duck)]</texture>
                <visible>!String.IsEmpty(Window.Property(weather.duck))</visible>
            </control>
            <!-- its line, in a yellow speech bubble pointing up at it -->
            <control type="group">
                <left>704</left><top>580</top>
                <visible>!String.IsEmpty(Window.Property(weather.tip))</visible>
                <control type="image">
                    <left>240</left><top>-12</top><width>32</width><height>32</height>
                    <texture colordiffuse="FFFFD23F">white.png</texture>
                    <animation effect="rotate" end="45" center="auto" time="0" condition="true">Conditional</animation>
                </control>
                <control type="image"><left>0</left><top>0</top><width>512</width><height>96</height><texture border="24" colordiffuse="FFFFD23F">card.png</texture></control>
                <control type="label">
                    <left>24</left><top>0</top><width>464</width><height>96</height>
                    <align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
                    <font>font27</font><textcolor>FF1D1D1D</textcolor>
                    <label>[B]$INFO[Window.Property(weather.tip)][/B]</label>
                </control>
            </control>

            <!-- ================= right: the frog of the day ================= -->
            <control type="group">
                <left>1248</left><top>40</top>
                <visible>!String.IsEmpty(Window.Property(frog.name))</visible>
                <!-- 600x300 (2:1), cropped; the texture itself stays within
                     Kodi's 540 px limit (advancedsettings imageres), scaled. -->
                <control type="image">
                    <left>0</left><top>0</top><width>600</width><height>300</height>
                    <aspectratio>scale</aspectratio>
                    <fadetime>400</fadetime>
                    <texture background="true">$INFO[Window.Property(frog.photo)]</texture>
                </control>
                <control type="label">
                    <left>0</left><top>316</top><width>600</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>FROG OF THE DAY</label>
                </control>
                <control type="label">
                    <left>0</left><top>344</top><width>600</width><height>50</height>
                    <font>font37</font><textcolor>FFF2F2F2</textcolor>
                    <label>[I]$INFO[Window.Property(frog.name)][/I]</label>
                </control>
                <control type="label">
                    <left>0</left><top>392</top><width>600</width><height>38</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(frog.common)]</label>
                </control>
                <!-- the status value carries its own [COLOR] (IUCN colour) -->
                <control type="label">
                    <left>0</left><top>430</top><width>600</width><height>32</height>
                    <font>font12</font><textcolor>FF8A8A8A</textcolor>
                    <label>$INFO[Window.Property(frog.family)]$INFO[Window.Property(frog.status),  ·  ]</label>
                </control>
                <!-- 5 lines: the TV summary is up to ~260 characters
                     (dashd TV_SUMMARY_CHARS); ends at 674, before the row -->
                <control type="textbox">
                    <left>0</left><top>466</top><width>600</width><height>168</height>
                    <font>font12</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(frog.summary)]</label>
                </control>
                <control type="label">
                    <left>0</left><top>642</top><width>600</width><height>26</height>
                    <font>font10</font><textcolor>FF5A5A5A</textcolor>
                    <label>$INFO[Window.Property(frog.attribution)]</label>
                </control>
            </control>

            <!-- ================= bottom row: 712 to 1016 =================
                 Only the cards with something to show, left to right in a
                 grouplist (a hidden card takes no room). Three slots, all
                 570 wide with 33 between (1776): any card can land in any
                 slot. Window.Property(board.cards) (dashboard.py) is 1 while
                 the TO DO list has items, else 0.
                 With a message: the message first, yellow, two slots wide
                 (next days step aside), then TO DO, else now playing, else
                 the app.
                 Without one:
                   1  TO DO, then now playing + the carousel, else next
                      days + the app, both at once
                   0  now playing + next days + the app, else next days
                      wide (five days) + the app -->
            <control type="grouplist">
                <left>72</left><top>712</top><width>1776</width><height>304</height>
                <orientation>horizontal</orientation>
                <itemgap>33</itemgap>
                <scrolltime>0</scrolltime>

            <!-- the message from the app, while there is one: two slots
                 (570 + 33 + 570), big type up to 110 characters, smaller
                 past that (board.message_long, from dashd; at most 280) -->
            <control type="group">
                <width>1173</width><height>304</height>
                <visible>!String.IsEmpty(Window.Property(board.message))</visible>
                <animation effect="fade" time="400">Visible</animation>
                <control type="image"><left>0</left><top>0</top><width>1173</width><height>304</height><texture border="24" colordiffuse="FFFFD23F">card.png</texture></control>
                <control type="label">
                    <left>40</left><top>24</top><width>1093</width><height>28</height>
                    <font>font12</font><textcolor>B31D1D1D</textcolor>
                    <label>MESSAGE</label>
                </control>
                <control type="textbox">
                    <left>40</left><top>62</top><width>1093</width><height>214</height>
                    <font>font37</font><textcolor>FF1D1D1D</textcolor>
                    <label>[B]$INFO[Window.Property(board.message)][/B]</label>
                    <visible>String.IsEmpty(Window.Property(board.message_long))</visible>
                </control>
                <control type="textbox">
                    <left>40</left><top>62</top><width>1093</width><height>214</height>
                    <font>font27</font><textcolor>FF1D1D1D</textcolor>
                    <label>[B]$INFO[Window.Property(board.message)][/B]</label>
                    <visible>!String.IsEmpty(Window.Property(board.message_long))</visible>
                </control>
            </control>

            <!-- the TODO list: open items, then done ones (dimmed) for a while -->
            <control type="group">
                <width>570</width><height>304</height>
                <visible>!String.IsEmpty(Window.Property(board.items))</visible>
                <animation effect="fade" time="400">Visible</animation>
                <control type="image"><left>0</left><top>0</top><width>570</width><height>304</height><texture border="24" colordiffuse="14FFFFFF">card.png</texture></control>
                <control type="label">
                    <left>32</left><top>22</top><width>260</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>TO DO</label>
                </control>
                <control type="label">
                    <left>262</left><top>22</top><width>276</width><height>28</height>
                    <align>right</align><font>font12</font><textcolor>FF8A8A8A</textcolor>
                    <label>$INFO[Window.Property(board.count)]$INFO[Window.Property(board.more),  ·  ]</label>
                </control>
                <!-- rows: 6 x 34; a yellow dot for open, a green one for done -->
                <control type="group"><left>32</left><top>62</top>
                    <visible>!String.IsEmpty(Window.Property(board.item1.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item1.text)]</label><visible>String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item1.text)]</label><visible>!String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>96</top>
                    <visible>!String.IsEmpty(Window.Property(board.item2.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item2.text)]</label><visible>String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item2.text)]</label><visible>!String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>130</top>
                    <visible>!String.IsEmpty(Window.Property(board.item3.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item3.text)]</label><visible>String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item3.text)]</label><visible>!String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>164</top>
                    <visible>!String.IsEmpty(Window.Property(board.item4.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item4.text)]</label><visible>String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item4.text)]</label><visible>!String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>198</top>
                    <visible>!String.IsEmpty(Window.Property(board.item5.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item5.text)]</label><visible>String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item5.text)]</label><visible>!String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>232</top>
                    <visible>!String.IsEmpty(Window.Property(board.item6.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item6.text)]</label><visible>String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>476</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item6.text)]</label><visible>!String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                </control>
            </control>

                <!-- now playing (audio only). AirPlay's details are in
                     Window(Home), Plex music's in MusicPlayer; Player.*
                     covers both. -->
                <control type="group">
                    <width>570</width><height>304</height>
                    <visible>Player.HasAudio + !Player.HasVideo + [String.IsEmpty(Window.Property(board.message)) | String.IsEqual(Window.Property(board.cards),0)]</visible>
