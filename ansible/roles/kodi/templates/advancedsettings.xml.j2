<!-- CouchOS: tuned for a 1 GB Raspberry Pi 3B+. Managed by Ansible. -->
<advancedsettings version="1.0">
    <cache>
        <!-- Kodi uses up to 3x this in RAM: 40 MB -> ~120 MB. -->
        <memorysize>41943040</memorysize>
        <buffermode>1</buffermode>
        <readfactor>4</readfactor>
    </cache>
    <!-- Smaller artwork textures: less GPU memory and faster Plex browsing. -->
    <imageres>540</imageres>
    <fanartres>720</fanartres>
    <gui>
        <!-- Redraw only regions that changed (Kodi otherwise repaints the
             whole screen every frame: measured 85 % CPU after boot). -->
        <algorithmdirtyregions>3</algorithmdirtyregions>
        <!-- Skip processing and rendering of frames where nothing changed.
             Without it the GUI loop runs at 60 fps on a static screen
             (measured 35 % CPU on Kodi's home, 20-40 % on PM4K, at 600 MHz).
             Side effect: a notification can stay on screen for good (the
             CEC adapter's from startup did); service.couchos closes those. -->
        <smartredraw>true</smartredraw>
    </gui>
</advancedsettings>
