@@ -2909,6 +2911,28 @@ class HomeWindow(kodigui.BaseWindow, util.CronReceiver, CommonMixin, SpoilersMix
         # so there's nothing to draw. Let background tasks call showHubs() via
         # sectionHubsCallback when data actually arrives.

+    def onRemoteOpen(self, key=None, play=True, from_start=False, **kwargs):
+        """CouchOS: open a Plex item sent from a phone, the way a click on a
+        hub item does (same opener, same playback/transcode/resume handling).
+        Movies and episodes start playing; shows, seasons and the rest open
+        their screen. The item opens on top of whatever window is showing."""
+        if self._shuttingDown or self._restarting:
+            return
+        util.LOG("CouchOS: remote open {0} (play={1}, from_start={2})", key, play, from_start)
+        try:
+            extra = {'start_over': True} if from_start else {}
+            if play:
+                extra.update(auto_play=True, dialog_props=self.carriedProps)
+            command = opener.open(key, **extra)
+            if command == "NODATA":
+                raise util.NoDataException
+            if command:
+                self.processCommand(command)
+        except util.NoDataException:
+            util.ERROR("No data - deleted or server disconnected?", notify=True, time_ms=5000)
+        except Exception:
+            util.ERROR()
+
     def disableUpdates(self, *args, **kwargs):
         util.LOG("Sleep event, stopping updates")
         self._ignoreTick = True
