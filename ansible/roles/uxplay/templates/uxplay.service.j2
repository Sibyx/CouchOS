[Unit]
Description=UxPlay AirPlay receiver (forward-only) - CouchOS
# UxPlay renders nothing: it forwards RTP to airplay-bridge, and Kodi plays it.
After=airplay-bridge.service
Wants=airplay-bridge.service
StartLimitIntervalSec=0

[Service]
# A crash leaves the -dacp file behind; couchd would think a client is connected.
ExecStartPre=-/usr/bin/rm -f %h/.uxplay.dacp
ExecStart=/usr/local/bin/uxplay {{ uxplay_args }} -dacp %h/.uxplay.dacp
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
