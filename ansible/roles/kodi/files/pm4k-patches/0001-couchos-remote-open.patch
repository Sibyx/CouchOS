CouchOS: open a Plex item sent from a phone.

The phone app finds an item in the Plex catalog and couchd sends Kodi
JSONRPC.NotifyAll {"sender": "couchos", "message": "open",
"data": {"key": <ratingKey>, "play": true, "from_start": false}}.
PM4K's monitor turns it into a "remote.open" signal and the home window
opens the item with the same opener a click on a hub item uses, so
playback, transcoding, resume and watched state are PM4K's own.

--- a/lib/monitor.py
+++ b/lib/monitor.py
@@ -1,4 +1,6 @@
 # coding=utf-8
+import json
+
 from kodi_six import xbmc
 from .settings_util import getSetting
 from .properties_core import _setGlobalProperty
@@ -72,6 +74,22 @@ class UtilityMonitor(xbmc.Monitor, signalsmixin.SignalsMixin):
             return

         LOG("Notification: {} {} {}".format(sender, method, data))
+        if sender == 'couchos' and method == 'Other.open':
+            # CouchOS: a phone picked an item. JSONRPC.NotifyAll with
+            # sender "couchos", message "open", data {"key": ratingKey,
+            # "play": bool, "from_start": bool}. The home window opens it.
+            try:
+                args = json.loads(data) if data else {}
+            except ValueError:
+                args = {}
+            key = str(args.get('key') or '')
+            if key.isdigit():
+                self.trigger('remote.open', key=key, play=bool(args.get('play', True)),
+                             from_start=bool(args.get('from_start', False)))
+            else:
+                LOG("CouchOS: ignoring open without a numeric key: {}".format(data))
+            return
+
         if sender == 'script.plexmod' and method.endswith('RESTORE'):
             from .windows import kodigui, windowutils

