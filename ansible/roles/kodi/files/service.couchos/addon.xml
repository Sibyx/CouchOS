<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.couchos" name="CouchOS" version="1.3.1" provider-name="CouchOS">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <!-- Plex starts through PM4K's own kiosk mode. watch.py is resident: it
         holds the dashboard and the catalog ready in memory and opens them
         at once (Kodi's screensaver; NotifyAll couchos/catalog), runs
         couchd's commands (NotifyAll couchos/command), closes notifications
         stuck on screen and opens the dashboard when AirPlay music starts.
         default.py runs a command the old way, when watch.py isn't up. -->
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="watch.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">CouchOS integration</summary>
        <description lang="en_GB">Keeps the CouchOS dashboard and catalog ready, runs HDMI-CEC commands for couchd, clears stuck notifications, shows the dashboard for AirPlay music.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
