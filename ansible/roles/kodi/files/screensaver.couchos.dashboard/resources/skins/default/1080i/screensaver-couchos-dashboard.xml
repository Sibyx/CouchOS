<?xml version="1.0" encoding="UTF-8"?>
<!-- CouchOS dashboard, 1920x1080. Three columns on black:
       left    time, date, today's weather, the TODO list
       centre  the duck dressed for the weather, its tip, the message
       right   the frog of the day, the app's QR code
     Any card whose data is empty is hidden.

     Fonts are Estuary's (Kodi's default skin), used at their native size:
     scaling a font with a zoom animation scales its glyph texture, which
     blurs it and redraws the label every frame.
       WeatherTemp  Noto Sans bold 120     font37 / font27  Noto Sans 37 / 27
       font12 / font10  Noto Sans 25 / 23
     Data: Window.Property(<widget id>.<key>) from dashd's /v1/views/tv.
     Images dashd draws (duck, QR) are exactly the size placed here, within
     Kodi's 540 px image texture limit, so they are never scaled.
     Textures: white.png, card.png (rounded, 9-sliced with border 24),
     dot.png; all white, tinted with colordiffuse.
     Weather icons: Kodi's stock set, resource.images.weathericons.default.

     Careful with $INFO[info,prefix,suffix]: commas separate its parts, so
     no comma may appear inside one (System.Date(DDDD, D MMMM) breaks).

     Colours: FFF2F2F2 primary, FFB8B8B8 secondary, FF8A8A8A labels,
     FFFFD23F accent (the duck's yellow), FF7FB2E5 precipitation,
     card background 14FFFFFF. -->
<window>
    <defaultcontrol>-</defaultcontrol>
    <animation effect="fade" time="500">WindowOpen</animation>
    <animation effect="fade" time="250">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
        </control>

        <!-- Everything moves together a few pixels every few minutes (burn-in). -->
        <control type="group" id="100">
            <left>0</left><top>0</top>

            <!-- ================= left: time, date, today ================= -->
            <control type="label">
                <left>92</left><top>56</top><width>660</width><height>150</height>
                <font>WeatherTemp</font><textcolor>FFF2F2F2</textcolor>
                <label>$INFO[System.Time(HH:mm)]</label>
            </control>
            <control type="label">
                <left>98</left><top>200</top><width>660</width><height>50</height>
                <font>font37</font><textcolor>FFB8B8B8</textcolor>
                <label>$INFO[System.Date(DDDD)] $INFO[System.Date(D MMMM)]</label>
            </control>

            <control type="group">
                <left>96</left><top>288</top>
                <visible>!String.IsEmpty(Window.Property(weather.temp))</visible>
                <control type="image">
                    <left>-8</left><top>0</top><width>120</width><height>120</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(weather.icon),resource://resource.images.weathericons.default/,.png]</texture>
                </control>
                <control type="label">
                    <left>124</left><top>0</top><width>230</width><height>120</height>
                    <aligny>center</aligny>
                    <font>WeatherTemp</font><textcolor>FFF2F2F2</textcolor>
                    <label>$INFO[Window.Property(weather.temp)]</label>
                </control>
                <control type="label">
                    <left>356</left><top>14</top><width>304</width><height>50</height>
                    <font>font37</font><textcolor>FFF2F2F2</textcolor>
                    <label>$INFO[Window.Property(weather.condition)]</label>
                </control>
                <control type="label">
                    <left>356</left><top>64</top><width>304</width><height>40</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(weather.feels)]</label>
                </control>
                <control type="label">
                    <left>0</left><top>134</top><width>660</width><height>40</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(weather.highlow)]$INFO[Window.Property(weather.rain),   ·   ]$INFO[Window.Property(weather.sun),   ·   Sun ]</label>
                </control>

                <!-- next hours: 4 x 165. Columns written out: a script window
                     cannot use skin includes. Only the index and left differ. -->
                <control type="label">
                    <left>0</left><top>204</top><width>660</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>NEXT HOURS</label>
                </control>
                <control type="group"><left>0</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>165</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour1.time)]</label></control>
                    <control type="image"><left>50</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour1.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>165</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour1.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>165</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour1.rain)]</label></control>
                </control>
                <control type="group"><left>165</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>165</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour2.time)]</label></control>
                    <control type="image"><left>50</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour2.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>165</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour2.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>165</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour2.rain)]</label></control>
                </control>
                <control type="group"><left>330</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>165</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour3.time)]</label></control>
                    <control type="image"><left>50</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour3.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>165</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour3.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>165</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour3.rain)]</label></control>
                </control>
                <control type="group"><left>495</left><top>238</top>
                    <control type="label"><left>0</left><top>0</top><width>165</width><height>34</height><align>center</align><font>font27</font><textcolor>FFB8B8B8</textcolor><label>$INFO[Window.Property(weather.hour4.time)]</label></control>
                    <control type="image"><left>50</left><top>36</top><width>64</width><height>64</height><aspectratio>keep</aspectratio><texture>$INFO[Window.Property(weather.hour4.icon),resource://resource.images.weathericons.default/,.png]</texture></control>
                    <control type="label"><left>0</left><top>102</top><width>165</width><height>46</height><align>center</align><font>font37</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(weather.hour4.temp)]</label></control>
                    <control type="label"><left>0</left><top>148</top><width>165</width><height>30</height><align>center</align><font>font12</font><textcolor>FF7FB2E5</textcolor><label>$INFO[Window.Property(weather.hour4.rain)]</label></control>
                </control>
            </control>

            <!-- the TODO list: open items, then done ones (dimmed) for a while -->
            <control type="group">
                <left>96</left><top>732</top>
                <visible>!String.IsEmpty(Window.Property(board.items))</visible>
                <control type="image"><left>0</left><top>0</top><width>660</width><height>276</height><texture border="24" colordiffuse="14FFFFFF">card.png</texture></control>
                <control type="label">
                    <left>32</left><top>22</top><width>300</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>TO DO</label>
                </control>
                <control type="label">
                    <left>328</left><top>22</top><width>300</width><height>28</height>
                    <align>right</align><font>font12</font><textcolor>FF8A8A8A</textcolor>
                    <label>$INFO[Window.Property(board.count)]$INFO[Window.Property(board.more),  ·  ]</label>
                </control>
                <!-- rows: 6 x 34; a yellow dot for open, a green one for done -->
                <control type="group"><left>32</left><top>62</top>
                    <visible>!String.IsEmpty(Window.Property(board.item1.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item1.text)]</label><visible>String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item1.text)]</label><visible>!String.IsEmpty(Window.Property(board.item1.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>96</top>
                    <visible>!String.IsEmpty(Window.Property(board.item2.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item2.text)]</label><visible>String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item2.text)]</label><visible>!String.IsEmpty(Window.Property(board.item2.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>130</top>
                    <visible>!String.IsEmpty(Window.Property(board.item3.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item3.text)]</label><visible>String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item3.text)]</label><visible>!String.IsEmpty(Window.Property(board.item3.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>164</top>
                    <visible>!String.IsEmpty(Window.Property(board.item4.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item4.text)]</label><visible>String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item4.text)]</label><visible>!String.IsEmpty(Window.Property(board.item4.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>198</top>
                    <visible>!String.IsEmpty(Window.Property(board.item5.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item5.text)]</label><visible>String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item5.text)]</label><visible>!String.IsEmpty(Window.Property(board.item5.done))</visible></control>
                </control>
                <control type="group"><left>32</left><top>232</top>
                    <visible>!String.IsEmpty(Window.Property(board.item6.text))</visible>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FFFFD23F">dot.png</texture><visible>String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="image"><left>0</left><top>10</top><width>14</width><height>14</height><texture colordiffuse="FF8FBF7A">dot.png</texture><visible>!String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FFF2F2F2</textcolor><label>$INFO[Window.Property(board.item6.text)]</label><visible>String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                    <control type="label"><left>30</left><top>0</top><width>566</width><height>34</height><aligny>center</aligny><font>font27</font><textcolor>FF6A6A6A</textcolor><label>$INFO[Window.Property(board.item6.text)]</label><visible>!String.IsEmpty(Window.Property(board.item6.done))</visible></control>
                </control>
            </control>

            <!-- ================= centre: the duck ================= -->
            <control type="image">
                <left>804</left><top>64</top><width>512</width><height>512</height>
                <fadetime>400</fadetime>
                <texture background="true">$INFO[Window.Property(weather.duck)]</texture>
                <visible>!String.IsEmpty(Window.Property(weather.duck))</visible>
            </control>
            <!-- its line, in a yellow speech bubble pointing up at it -->
            <control type="group">
                <left>788</left><top>608</top>
                <visible>!String.IsEmpty(Window.Property(weather.tip))</visible>
                <control type="image">
                    <left>256</left><top>-12</top><width>32</width><height>32</height>
                    <texture colordiffuse="FFFFD23F">white.png</texture>
                    <animation effect="rotate" end="45" center="auto" time="0" condition="true">Conditional</animation>
                </control>
                <control type="image"><left>0</left><top>0</top><width>544</width><height>96</height><texture border="24" colordiffuse="FFFFD23F">card.png</texture></control>
                <control type="label">
                    <left>24</left><top>0</top><width>496</width><height>96</height>
                    <align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
                    <font>font27</font><textcolor>FF1D1D1D</textcolor>
                    <label>[B]$INFO[Window.Property(weather.tip)][/B]</label>
                </control>
            </control>

            <!-- the message from the app -->
            <control type="group">
                <left>788</left><top>732</top>
                <visible>!String.IsEmpty(Window.Property(board.message))</visible>
                <control type="image"><left>0</left><top>0</top><width>544</width><height>276</height><texture border="24" colordiffuse="14FFFFFF">card.png</texture></control>
                <control type="label">
                    <left>32</left><top>22</top><width>480</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>MESSAGE</label>
                </control>
                <control type="textbox">
                    <left>32</left><top>60</top><width>480</width><height>156</height>
                    <font>font27</font><textcolor>FFF2F2F2</textcolor>
                    <label>$INFO[Window.Property(board.message)]</label>
                </control>
                <control type="label">
                    <left>32</left><top>222</top><width>480</width><height>34</height>
                    <align>right</align><font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>[I]$INFO[Window.Property(board.from)][/I]</label>
                </control>
            </control>

            <!-- ================= right: the frog of the day ================= -->
            <control type="group">
                <left>1392</left><top>64</top>
                <visible>!String.IsEmpty(Window.Property(frog.name))</visible>
                <!-- 432x288 (3:2), cropped: within Kodi's 540 px image texture limit. -->
                <control type="image">
                    <left>0</left><top>0</top><width>432</width><height>288</height>
                    <aspectratio>scale</aspectratio>
                    <fadetime>400</fadetime>
                    <texture background="true">$INFO[Window.Property(frog.photo)]</texture>
                </control>
                <control type="label">
                    <left>0</left><top>304</top><width>432</width><height>28</height>
                    <font>font12</font><textcolor>FFFFD23F</textcolor>
                    <label>FROG OF THE DAY</label>
                </control>
                <control type="label">
                    <left>0</left><top>334</top><width>432</width><height>50</height>
                    <font>font37</font><textcolor>FFF2F2F2</textcolor>
                    <label>[I]$INFO[Window.Property(frog.name)][/I]</label>
                </control>
                <control type="label">
                    <left>0</left><top>382</top><width>432</width><height>38</height>
                    <font>font27</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(frog.common)]</label>
                </control>
                <!-- the status value carries its own [COLOR] (IUCN colour) -->
                <control type="label">
                    <left>0</left><top>422</top><width>432</width><height>32</height>
                    <font>font12</font><textcolor>FF8A8A8A</textcolor>
                    <label>$INFO[Window.Property(frog.family)]$INFO[Window.Property(frog.status),  ·  ]</label>
                </control>
                <control type="textbox">
                    <left>0</left><top>460</top><width>432</width><height>160</height>
                    <font>font12</font><textcolor>FFB8B8B8</textcolor>
                    <label>$INFO[Window.Property(frog.summary)]</label>
                </control>
                <control type="label">
                    <left>0</left><top>630</top><width>432</width><height>26</height>
                    <font>font10</font><textcolor>FF5A5A5A</textcolor>
                    <label>$INFO[Window.Property(frog.attribution)]</label>
                </control>
            </control>

            <!-- the app: scan from the couch -->
            <control type="group">
                <left>1392</left><top>732</top>
                <visible>!String.IsEmpty(Window.Property(app.image))</visible>
                <control type="image"><left>0</left><top>0</top><width>432</width><height>276</height><texture border="24" colordiffuse="14FFFFFF">card.png</texture></control>
                <!-- 198 px = 33 modules x 6: drawn at its own size, never scaled -->
                <control type="image">
                    <left>24</left><top>39</top><width>198</width><height>198</height>
                    <texture background="true">$INFO[Window.Property(app.image)]</texture>
                </control>
                <control type="label">
                    <left>244</left><top>52</top><width>168</width><height>90</height>
                    <aligny>top</aligny><wrapmultiline>true</wrapmultiline>
                    <font>font27</font><textcolor>FFF2F2F2</textcolor>
                    <label>[B]$INFO[Window.Property(app.title)][/B]</label>
                </control>
                <control type="textbox">
                    <left>244</left><top>144</top><width>168</width><height>96</height>
                    <font>font12</font><textcolor>FF8A8A8A</textcolor>
                    <label>$INFO[Window.Property(app.subtitle)]</label>
                </control>
            </control>

            <!-- quiet notice when the data is old -->
            <control type="label">
                <left>96</left><top>1030</top><width>900</width><height>28</height>
                <font>font10</font><textcolor>FF5A5A5A</textcolor>
                <label>Dashboard data is not updating</label>
                <visible>String.IsEqual(Window.Property(offline),true) | String.IsEqual(Window.Property(weather.stale),true)</visible>
            </control>
        </control>
    </controls>
</window>
