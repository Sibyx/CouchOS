<!-- CouchOS catalog: search, 1920x1080 on black.

       x   72 ............ 552   616 ............................. 1848
     y  40 COUCHOS · SEARCH        the focused title, its facts, 2 lines
        96 [ query        kind ]
       200 letter grid 6 x 6       216 row 1: title, then posters
       640 Space Delete Clear ..   486 row 2
       744 libraries               756 row 3
      1036 key hints

     Rows: three on screen; Kodi moves between them, and app.py scrolls
     the rest in when the focus reaches a sentinel (300 above, 304 below).
     List text is in ListItem.Property(label/label2), not the label
     (number keys would jump the lists by label). Posters
     152 x 228 (couchd's 320 x 480 file, scaled down).
     Fonts and colours as the dashboard (screensaver.couchos.dashboard):
     FFF2F2F2 primary, FFB8B8B8 secondary, FF8A8A8A labels, FF5A5A5A
     quiet, FFFFD23F accent. Script windows cannot use skin includes, so
     the three rows and the three info blocks are written out. -->
<window>
    <defaultcontrol>200</defaultcontrol>
    <animation effect="fade" time="200">WindowOpen</animation>
    <animation effect="fade" time="150">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF000000">white.png</texture>
        </control>

        <!-- ================= left: query, letters, libraries ================= -->
        <control type="label">
            <left>72</left><top>40</top><width>480</width><height>32</height>
            <font>font12</font><textcolor>FFFFD23F</textcolor>
            <label>COUCHOS  ·  SEARCH</label>
        </control>
        <control type="group">
            <left>72</left><top>96</top>
            <control type="image"><left>0</left><top>0</top><width>480</width><height>84</height><texture border="24" colordiffuse="1FFFFFFF">card.png</texture></control>
            <control type="label">
                <left>24</left><top>0</top><width>330</width><height>84</height>
                <aligny>center</aligny><font>font37</font><textcolor>FFF2F2F2</textcolor>
                <label>[B]$INFO[Window.Property(query)][/B][COLOR FFFFD23F]|[/COLOR]</label>
                <visible>!String.IsEmpty(Window.Property(query))</visible>
            </control>
            <control type="label">
                <left>24</left><top>0</top><width>330</width><height>84</height>
                <aligny>center</aligny><font>font37</font><textcolor>FF5A5A5A</textcolor>
                <label>Search</label>
                <visible>String.IsEmpty(Window.Property(query))</visible>
