<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>CouchOS shows the Reminders lists you choose on your TV: a to-do list, and a list of movies to watch (with their links), matched to your Plex library. It ticks items off in Reminders when you tick them in the app.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_couchos._tcp</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
